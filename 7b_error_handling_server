
from flask import Flask, render_template, request
from EmotionDetection.emotion_detection import emotion_detector

app = Flask(__name__)


@app.route("/")
def render_index_page():
    """Render the home page."""
    return render_template("index.html")


@app.route("/emotionDetector", methods=["GET", "POST"])
def emotion_detector_route():
    """Handle text input and return emotion analysis."""
    text_to_analyze = request.args.get("textToAnalyze", "")

    # Handle blank or whitespace-only input.
    if not text_to_analyze.strip():
        return "Invalid text! Please enter a sentence.", 400

    result = emotion_detector(text_to_analyze)

    if result is None or result.get("dominant_emotion") is None:
        return "Unable to analyze the provided text.", 400

    response = (
        "For the given statement, the system response is "
        f"'anger': {result['anger']}, "
        f"'disgust': {result['disgust']}, "
        f"'fear': {result['fear']}, "
        f"'joy': {result['joy']}, "
        f"'sadness': {result['sadness']}. "
        f"The dominant emotion is {result['dominant_emotion']}."
    )

    return response, 200


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
